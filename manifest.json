{
  "manifest_version": 3,
  "name": "AeroGuard Pro",
  "version": "2.0.0",
  "description": "Production-grade ad blocker with YouTube-specific protection",
  "default_locale": "en",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "storage",
    "scripting",
    "tabs",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AeroGuard Pro"
  },
  "options_page": "options/options.html",
  "incognito": "split",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ruleset_dynamic", "enabled": true, "path": "rules/dynamic.json" }
    ],
    "max_number_of_enabled_rulesets": 1,
    "max_number_of_static_rules": 5000,
    "max_number_of_dynamic_rules": 30000,
    "max_number_of_session_rules": 5000,
    "max_number_of_regex_rules": 100
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["content/yt.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["content/generic.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [{
    "resources": ["scriptlets/*.js"],
    "matches": ["<all_urls>"],
    "use_dynamic_url": true
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}